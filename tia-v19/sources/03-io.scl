FUNCTION "ROLL_ReadInputs" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_TEMP
    b : Int;
    bit : Int;
END_VAR
BEGIN
    // Confirmed four-station profile: absent optional inputs are zero.
    FOR #b := 119 TO 125 DO
        FOR #bit := 0 TO 7 DO "ROLL_IO".Input[#b, #bit] := FALSE; END_FOR;
    END_FOR;
    IF "ROLL_IO".PhysicalIoConfigured AND NOT "ROLL_IO".Simulation THEN
        "ROLL_IO".Input[0, 0] := %I0.0;
        "ROLL_IO".Input[0, 1] := %I0.1;
        "ROLL_IO".Input[0, 2] := %I0.2;
        "ROLL_IO".Input[0, 3] := %I0.3;
