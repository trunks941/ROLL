FUNCTION "ROLL_WriteOutputs" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_TEMP
    enabled : Bool;
END_VAR
BEGIN
    IF "ROLL_IO".PhysicalIoConfigured THEN
        #enabled := "ROLL_IO".PhysicalOutputsEnabled AND NOT "ROLL_IO".Simulation AND NOT "ROLL_IO".ConversionFault;
        %Q16.0 := #enabled AND "ROLL_IO".Output[16, 0];
        %Q16.1 := #enabled AND "ROLL_IO".Output[16, 1];
        %Q16.2 := #enabled AND "ROLL_IO".Output[16, 2];
        %Q16.3 := #enabled AND "ROLL_IO".Output[16, 3];
