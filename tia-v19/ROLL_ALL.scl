    "ROLL_HMI".Dwell1Seconds := "ROLL_DecodeBCD"(Value := "ROLL_DB205".DW[5]);
    "ROLL_HMI".Drain1Seconds := "ROLL_DecodeBCD"(Value := "ROLL_DB205".DW[9]);
