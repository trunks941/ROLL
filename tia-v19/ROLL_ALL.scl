        %Q18.1 := #enabled AND "ROLL_IO".Output[18, 1];
        %Q18.2 := #enabled AND "ROLL_IO".Output[18, 2];
        %Q18.3 := #enabled AND "ROLL_IO".Output[18, 3];
        %Q18.4 := #enabled AND "ROLL_IO".Output[18, 4];
