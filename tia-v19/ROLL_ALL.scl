        %Q20.5 := #enabled AND "ROLL_IO".Output[20, 5];
        %Q20.6 := #enabled AND "ROLL_IO".Output[20, 6];
        %Q20.7 := #enabled AND "ROLL_IO".Output[20, 7];
        %Q21.0 := #enabled AND "ROLL_IO".Output[21, 0];
        %Q21.1 := #enabled AND "ROLL_IO".Output[21, 1];
        %Q21.2 := #enabled AND "ROLL_IO".Output[21, 2];
        %Q21.3 := #enabled AND "ROLL_IO".Output[21, 3];
        %Q21.4 := #enabled AND "ROLL_IO".Output[21, 4];
        %Q21.5 := #enabled AND "ROLL_IO".Output[21, 5];
        %Q21.6 := #enabled AND "ROLL_IO".Output[21, 6];
        %Q21.7 := #enabled AND "ROLL_IO".Output[21, 7];
