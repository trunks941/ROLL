// ROLL migration prototype. Compile and verify in TIA V19 before commissioning.
// No absolute M aliases: byte/word reads below preserve S5 overlapping memory.
TYPE "ROLL_TimerState"
VERSION : 0.1
STRUCT
    RemainingMs : LReal;
    BaseMs : Int;
    Mode : Int;
    Previous : Bool;
    Q : Bool;
END_STRUCT;
END_TYPE

TYPE "ROLL_CounterState"
VERSION : 0.1
STRUCT
    Value : Int;
    SetPrevious : Bool;
    UpPrevious : Bool;
    DownPrevious : Bool;
END_STRUCT;
END_TYPE

DATA_BLOCK "ROLL_State"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
VAR
    M : Array[0..255, 0..7] of Bool;
    Timer : Array[0..127] of "ROLL_TimerState";
    Counter : Array[0..127] of "ROLL_CounterState";
    CurrentProgram : Int := 1;
END_VAR
BEGIN
    M[0, 4] := TRUE;
END_DATA_BLOCK

DATA_BLOCK "ROLL_IO"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
VAR
    Input : Array[0..127, 0..7] of Bool;
    Output : Array[0..127, 0..7] of Bool;
    Simulation : Bool := TRUE;
    PhysicalOutputsEnabled : Bool := FALSE;
    PhysicalIoConfigured : Bool := FALSE;
    ConversionFault : Bool;
    FirstCycle : Bool := TRUE;
    RuntimeMemory : LReal;
    ClockMs : LReal;
    HmiElapsedMs : LReal;
    HmiLastHeartbeat : DInt;
END_VAR
BEGIN
END_DATA_BLOCK

// Flat, symbolic WinCC interface; TP900 control binding is a separate build step.
DATA_BLOCK "ROLL_HMI"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
VAR
    Heartbeat : DInt;
    Connected : Bool;
    ManualFunction : Int := 255;
    GroundHeld : Bool;
    WorkHeld : Bool;
    KeyF : Array[1..16] of Bool;
    SelectedProgram : Int := 1;
    RecipeCommand : Int := 1;
    RecipeRequest : DInt;
    RecipeAck : DInt;
    RecipeError : Int;
    CurrentProgram : Int := 1;
    ParameterRequest : DInt;
    ParameterAck : DInt;
    ParameterDb : Int := 15;
    ParameterIndex : Int;
    ParameterValue : DInt;
    ParameterCurrentValue : DInt;
    ParameterSlotPresent : Bool;
    ParameterError : Int;
    Dwell1Seconds : Int := 360;
    Drain1Seconds : Int := 90;
    Ultrasound1 : Bool := TRUE;
    Dwell2Seconds : Int := 240;
    Drain2Seconds : Int := 60;
    Dwell3Seconds : Int := 300;
    Drain3Seconds : Int := 120;
    Dry4Seconds : Int := 400;
    BasketMotion : Int := 1;
    BathLift : Bool;
    ProcessTimer1Units : Int;
    ProcessTimer2Units : Int;
    StatusM : Array[0..255, 0..7] of Bool;
    LogicalOutputs : Array[16..25, 0..7] of Bool;
END_VAR
BEGIN
END_DATA_BLOCK


