        %Q22.6 := #enabled AND "ROLL_IO".Output[22, 6];
        %Q22.7 := #enabled AND "ROLL_IO".Output[22, 7];
        %Q23.0 := #enabled AND "ROLL_IO".Output[23, 0];
        %Q23.1 := #enabled AND "ROLL_IO".Output[23, 1];
        %Q23.2 := #enabled AND "ROLL_IO".Output[23, 2];
        %Q23.3 := #enabled AND "ROLL_IO".Output[23, 3];
        %Q23.4 := #enabled AND "ROLL_IO".Output[23, 4];
