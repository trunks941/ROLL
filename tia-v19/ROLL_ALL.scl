        %Q18.6 := #enabled AND "ROLL_IO".Output[18, 6];
        %Q18.7 := #enabled AND "ROLL_IO".Output[18, 7];
        %Q19.0 := #enabled AND "ROLL_IO".Output[19, 0];
        %Q19.1 := #enabled AND "ROLL_IO".Output[19, 1];
        %Q19.2 := #enabled AND "ROLL_IO".Output[19, 2];
        %Q19.3 := #enabled AND "ROLL_IO".Output[19, 3];
        %Q19.4 := #enabled AND "ROLL_IO".Output[19, 4];
        %Q19.5 := #enabled AND "ROLL_IO".Output[19, 5];
        %Q19.6 := #enabled AND "ROLL_IO".Output[19, 6];
        %Q19.7 := #enabled AND "ROLL_IO".Output[19, 7];
        %Q20.0 := #enabled AND "ROLL_IO".Output[20, 0];
        %Q20.1 := #enabled AND "ROLL_IO".Output[20, 1];
        %Q20.2 := #enabled AND "ROLL_IO".Output[20, 2];
        %Q20.3 := #enabled AND "ROLL_IO".Output[20, 3];
